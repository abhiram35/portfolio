# Copy this file to .env and fill it in. .env is git-ignored.

PORT=3001

# Comma-separated list of sites allowed to call the API.
# Add your live site's origin, e.g. https://abhiram35.github.io
ALLOWED_ORIGINS=http://localhost:5173

# Where contact messages are sent. Leave SMTP_USER/SMTP_PASS empty locally
# to save messages to server/messages.jsonl instead.
# For Gmail, SMTP_PASS must be an App Password (Google Account > Security > App passwords),
# not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=pabhiram356@gmail.com
